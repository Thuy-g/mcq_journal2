{
  "version": "predicate_policy/1.0.0",
  "notes": {
    "scope": "Hard eligibility filters applied BEFORE the exact set-cover dynamic program (Prompt 8F section 9). A rejected predicate can never appear in a rationale under any evidence policy.",
    "conservatism": "The reject list is deliberately short and grounded: every entry either belongs to a category named in Prompt 8F section 9.1 (external URL / homepage, thumbnail / image / logo / file, raw media or map) or is a raw infobox display slot actually observed in the Prompt-8D pilot facts. No predicate was rejected speculatively.",
    "tiers": "pedagogical_tier is an ORDERING aid used only to break ties among equally small rationales. It is not a truth claim and it never changes an evidence level.",
    "templates": "Prompt 8F stops before natural-language verbalization. The registry below records a TEMPLATE ID and a directional reading only, so that a later verbalization task inherits a checked direction instead of re-deriving one. No sentence is generated here.",
    "unknown_templates": "A predicate-direction pair with no registered template is VERBALIZABLE_UNKNOWN. It remains usable for diagnostics and can never silently outrank a template-ready rationale."
  },
  "object_policy": {
    "resource_namespace_prefixes": ["http://dbpedia.org/resource/"],
    "web_archive_hosts": ["web.archive.org", "archive.org", "webcitation.org"],
    "media_file_suffixes": [".jpg", ".jpeg", ".png", ".gif", ".svg", ".tif", ".tiff", ".webp", ".ogg", ".ogv", ".oga", ".mp3", ".mp4", ".webm", ".wav", ".pdf", ".djvu"],
    "maximum_object_label_length": 120,
    "minimum_object_label_length": 1,
    "machine_identifier_minimum_digit_ratio": 0.6,
    "educational_allowlist": [],
    "educational_allowlist_note": "An object rejected by the rules above may be re-admitted only by an explicit entry here. The pilot needs none, and an empty list is published rather than omitted so that 'no exception was used' is visible.",
    "reject_reason_codes": {
      "OBJECT_EXTERNAL_URL": "The object is not a DBpedia resource: it is an external web address, so it names a page rather than an entity.",
      "OBJECT_WEB_ARCHIVE_URL": "The object is a Web Archive snapshot URL.",
      "OBJECT_MEDIA_FILE": "The object names an image, audio, video or document file.",
      "OBJECT_EMPTY_LABEL": "The object has no readable local name.",
      "OBJECT_LABEL_TOO_LONG": "The object's readable label exceeds the configured maximum length, so it is a raw literal rather than an entity name.",
      "OBJECT_MACHINE_IDENTIFIER": "The object's local name is predominantly digits or an opaque identifier with no readable word."
    }
  },
  "leakage_policy": {
    "minimum_token_length": 4,
    "minimum_prefix_length": 5,
    "soft_prefix_length": 4,
    "strip_suffixes": ["s", "es"],
    "hard_reason_code": "ANSWER_LEXICAL_LEAK",
    "soft_reason_code": "ANSWER_LEXICAL_LEAK_SOFT",
    "notes": {
      "pipeline": "Unicode NFKC, percent decoding, casefold, URI local-name extraction, tokenization on underscores / hyphens / punctuation, then whole-token, light-plural-stem and long-prefix comparison. No spaCy, no WordNet, no embedding.",
      "why_two_thresholds": "A whole-token match at four characters catches 'Adam Smith' against 'Smithsonian'; a five-character prefix catches 'Carbon' against 'Carbonado' while leaving 'Carbon' against 'Boron carbide' alone, whose longest shared prefix is only 'carb'.",
      "display_labels_are_separate": "Leakage tokenization never feeds display. The old broad remove_parenthetical() behaviour is not used for display or for semantic identity: it turns Iron(III) chloride and Iron(II) chloride into the same string (AUDIT item CE-10, test T2.5), which would both misname the entity and make two choices indistinguishable."
    }
  },
  "reject_reason_codes": {
    "PREDICATE_EXTERNAL_URL_FIELD": "Carries an external web address rather than a fact about the entity.",
    "PREDICATE_MEDIA_OR_IMAGE_FIELD": "Names an image, logo, thumbnail or media file.",
    "PREDICATE_MAP_FIELD": "Names a map image or map rendering parameter.",
    "PREDICATE_RAW_LAYOUT_SLOT": "A generic infobox display slot (caption, label, free-form data cell) with no stable semantics.",
    "PREDICATE_TEMPLATE_PARAMETER": "A numbered or positional infobox template parameter, not a property of the entity."
  },
